{
  "name": "orbit-workbench",
  "private": true,
  "version": "0.1.4",
  "description": "Local-first bookmark and kubeconfig workbench",
  "author": "Orbit Workbench",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "check": "tsc -b --pretty false",
    "test": "node --test tests/*.test.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "app:dir": "npm run build && electron-builder --mac --dir --publish never",
    "app:dmg": "npm run build && electron-builder --mac dmg --publish never",
    "app:win": "npm run build && electron-builder --win --x64 --publish never",
    "app:win:dir": "npm run build && electron-builder --win dir --x64 --publish never",
    "app:win:nsis": "npm run build && electron-builder --win nsis --x64 --publish never",
    "app:win:zip": "npm run build && electron-builder --win zip --x64 --publish never",
    "app:open": "open \"release/mac-arm64/Orbit Workbench.app\""
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "prismjs": "^1.30.0",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/prismjs": "^1.26.6",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "electron": "latest",
    "electron-builder": "latest",
    "jsdom": "^30.1.3",
    "typescript": "latest"
  },
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "build": {
    "appId": "com.orbit.workbench",
    "productName": "Orbit Workbench",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "shared/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "artifactName": "Orbit-Workbench-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Orbit-Workbench-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": false,
      "deleteAppDataOnUninstall": false
    }
  }
}
