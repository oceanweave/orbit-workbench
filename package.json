{
  "name": "orbit-workbench",
  "private": true,
  "version": "0.1.0",
  "description": "Local-first bookmark and kubeconfig workbench",
  "author": "Orbit Workbench",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "app:dir": "npm run build && electron-builder --mac --dir",
    "app:dmg": "npm run build && electron-builder --mac dmg",
    "app:open": "open \"release/mac-arm64/Orbit Workbench.app\""
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "electron": "latest",
    "electron-builder": "latest",
    "typescript": "latest"
  },
  "build": {
    "appId": "com.orbit.workbench",
    "productName": "Orbit Workbench",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64"]
        }
      ]
    }
  }
}
